<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_marginTop="7dp"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/deploy_slot_bg">


    <ImageView
        android:id="@+id/replaceChickenImage"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:scaleType="fitCenter"
        android:contentDescription="Current chicken" />


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">


        <TextView
            android:id="@+id/replaceChickenName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Basic Chicken"
            android:textColor="#57351F"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-rounded" />


        <TextView
            android:id="@+id/replaceChickenStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level 0 • 1 Egg"
            android:textColor="#795638"
            android:textSize="12sp"
            android:fontFamily="sans-serif-rounded" />

    </LinearLayout>


    <Button
        android:id="@+id/replaceChickenButton"
        android:layout_width="100dp"
        android:layout_height="45dp"
        android:text="REPLACE"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/shop_deploy_button_bg"
        android:backgroundTint="@null" />

</LinearLayout>