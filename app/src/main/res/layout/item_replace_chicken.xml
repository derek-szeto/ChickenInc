<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"

    android:orientation="horizontal"

    android:gravity="center_vertical"

    android:padding="10dp"

    android:background="@drawable/deploy_slot_bg">


    <!-- IMAGE -->

    <ImageView
        android:id="@+id/replaceChickenImage"

        android:layout_width="72dp"
        android:layout_height="72dp"

        android:scaleType="fitCenter"

        android:contentDescription="Current chicken" />


    <!-- INFO -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_weight="1"

        android:layout_marginStart="9dp"
        android:layout_marginEnd="7dp"

        android:orientation="vertical">


        <TextView
            android:id="@+id/replaceChickenName"

            style="@style/GameResponsiveName"

            android:layout_width="match_parent"
            android:layout_height="42dp"

            android:gravity="start|center_vertical"

            android:text="Best Strawberry Chicken"

            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="16sp"

            android:maxLines="2" />


        <TextView
            android:id="@+id/replaceChickenStats"

            style="@style/GameText"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="2dp"

            android:text="Level 4 • 15 Eggs"

            android:textColor="#795638"

            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp"

            android:maxLines="1" />

    </LinearLayout>


    <!-- REPLACE -->

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/replaceChickenButton"

        style="@style/GameButtonText"

        android:layout_width="92dp"
        android:layout_height="46dp"

        android:text="REPLACE"

        android:textColor="#FFFFFF"

        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeStepGranularity="1sp"

        android:background="@drawable/game_deploy_button_bg"

        app:backgroundTint="@null" />

</LinearLayout>