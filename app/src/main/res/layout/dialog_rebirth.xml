<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/rebirthPopupRoot"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"

    android:gravity="center"

    android:padding="22dp"

    android:background="@drawable/rebirth_popup_bg">


    <!-- TITLE -->

    <TextView
        style="@style/GameTitle"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center"

        android:text="⭐ REBIRTH? ⭐"

        android:textColor="#6B357F"
        android:textSize="27sp" />


    <!-- DESCRIPTION -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="6dp"

        android:gravity="center"

        android:text="Restart your progress for a permanent production boost!"

        android:textColor="#57351F"
        android:textSize="15sp"

        android:fontFamily="@font/fredoka_semibold" />


    <!-- MULTIPLIER CARD -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="17dp"

        android:orientation="horizontal"

        android:gravity="center"

        android:padding="14dp"

        android:background="@drawable/main_small_badge_bg">


        <!-- CURRENT -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">


            <TextView
                style="@style/GameText"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="CURRENT"

                android:textColor="#795638"
                android:textSize="13sp" />


            <TextView
                android:id="@+id/currentRebirthMultiplierText"

                style="@style/GameTitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="x1"

                android:textColor="#57351F"
                android:textSize="29sp" />

        </LinearLayout>


        <!-- ARROW -->

        <TextView
            style="@style/GameTitle"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="→"

            android:textColor="#F6A63A"
            android:textSize="30sp" />


        <!-- NEXT -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">


            <TextView
                style="@style/GameText"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="NEW"

                android:textColor="#795638"
                android:textSize="13sp" />


            <TextView
                android:id="@+id/nextRebirthMultiplierText"

                style="@style/GameTitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="x2"

                android:textColor="#3FB85A"
                android:textSize="29sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- PERK -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="15dp"

        android:gravity="center"

        android:text="🐔 Applies permanently to ALL chickens"

        android:textColor="#57351F"
        android:textSize="16sp"

        android:fontFamily="@font/fredoka_bold" />


    <!-- EXAMPLE -->

    <TextView
        android:id="@+id/rebirthExampleText"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="7dp"

        android:gravity="center"

        android:text="1 egg → 2 eggs per chicken"

        android:textColor="#3FB85A"
        android:textSize="15sp"

        android:fontFamily="@font/fredoka_semibold" />


    <!-- COST -->

    <TextView
        android:id="@+id/rebirthCostText"

        style="@style/GameTitle"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="16dp"

        android:gravity="center"

        android:text="Requires: 🥚 100K"

        android:textColor="#57351F"
        android:textSize="18sp" />


    <!-- RESET INFO -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="9dp"

        android:gravity="center"

        android:text="Resets eggs and chicken upgrade levels.\nYour chickens and permanent multiplier stay!"

        android:textColor="#795638"
        android:textSize="13sp"

        android:fontFamily="@font/fredoka_semibold" />


    <!-- BUTTONS -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"

        android:layout_marginTop="18dp"

        android:orientation="horizontal">


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cancelRebirthButton"

            style="@style/GameButtonText"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:layout_marginEnd="5dp"

            android:text="CANCEL"

            android:textColor="#FFFFFF"
            android:textSize="14sp"

            android:background="@drawable/game_back_button_bg"

            app:backgroundTint="@null" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/confirmRebirthButton"

            style="@style/GameButtonText"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:layout_marginStart="5dp"

            android:text="⭐ REBIRTH"

            android:textColor="#FFFFFF"
            android:textSize="14sp"

            android:background="@drawable/main_rebirth_button_bg"

            app:backgroundTint="@null" />

    </LinearLayout>

</LinearLayout>