<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"

    android:padding="18dp"

    android:background="@drawable/deploy_popup_bg">


    <!-- TITLE -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center"

        android:text="CHOOSE A CHICKEN TO REPLACE"

        android:textColor="#57351F"

        android:fontFamily="@font/fredoka_bold"

        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="22sp"
        android:autoSizeStepGranularity="1sp"

        android:maxLines="2" />


    <!-- NEW CHICKEN -->

    <ImageView
        android:id="@+id/newChickenImage"

        android:layout_width="120dp"
        android:layout_height="120dp"

        android:layout_gravity="center_horizontal"

        android:layout_marginTop="8dp"

        android:scaleType="fitCenter"

        android:contentDescription="New chicken" />


    <TextView
        android:id="@+id/newChickenName"

        style="@style/GameResponsiveName"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:minHeight="48dp"

        android:gravity="center"

        android:text="Best Strawberry Chicken"

        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="22sp"

        android:maxLines="2" />


    <TextView
        android:id="@+id/newChickenRarity"

        style="@style/GameTitle"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center"

        android:text="Legendary"

        android:textSize="15sp"

        android:textColor="#FFD338" />


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"

        android:gravity="center"

        android:text="Your farm is full. Pick an active chicken to replace."

        android:textColor="#795638"

        android:fontFamily="@font/fredoka_semibold"

        android:textSize="14sp" />


    <!-- CURRENT CHICKENS -->

    <LinearLayout
        android:id="@+id/replacementContainer"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="12dp"

        android:orientation="vertical" />


    <!-- CANCEL -->

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/cancelDeployButton"

        style="@style/GameButtonText"

        android:layout_width="190dp"
        android:layout_height="52dp"

        android:layout_gravity="center_horizontal"

        android:layout_marginTop="12dp"

        android:text="CANCEL"

        android:textColor="#FFFFFF"
        android:textSize="14sp"

        android:background="@drawable/game_back_button_bg"

        app:backgroundTint="@null" />

</LinearLayout>