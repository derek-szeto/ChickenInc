<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp"
    android:background="@drawable/deploy_popup_bg">


    <!-- TITLE -->
    <TextView
        android:id="@+id/deployPopupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Deploy Chicken"
        android:textColor="#57351F"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-rounded" />


    <!-- NEW CHICKEN -->
    <ImageView
        android:id="@+id/newChickenImage"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginTop="10dp"
        android:scaleType="fitCenter"
        android:contentDescription="Chicken to deploy" />


    <TextView
        android:id="@+id/newChickenName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Diamond Chicken"
        android:textColor="#57351F"
        android:textSize="19sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-rounded" />


    <TextView
        android:id="@+id/newChickenRarity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Epic"
        android:textColor="#B85BEA"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-rounded" />


    <!-- EXPLANATION -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Your farm is full!\nChoose a chicken to replace."
        android:textColor="#69462D"
        android:textSize="15sp"
        android:fontFamily="sans-serif-rounded" />


    <!-- ACTIVE CHICKENS ARE ADDED HERE -->
    <LinearLayout
        android:id="@+id/replacementContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="vertical" />


    <Button
        android:id="@+id/cancelDeployButton"
        android:layout_width="180dp"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:text="CANCEL"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:fontFamily="sans-serif-rounded"
        android:background="@drawable/shop_close_bg"
        android:backgroundTint="@null" />


</LinearLayout>