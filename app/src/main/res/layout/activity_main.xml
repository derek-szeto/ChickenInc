<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- ========================= -->
    <!-- BACKGROUND -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/default_bg"
        android:scaleType="centerCrop"
        android:contentDescription="Farm background" />


    <!-- ========================= -->
    <!-- GAME UI -->
    <!-- ========================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:paddingTop="58dp"
        android:paddingBottom="40dp">


        <!-- ========================= -->
        <!-- TOP HUD -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/topHud"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- EGGS -->
            <TextView
                android:id="@+id/eggCountText"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/hud_panel_bg"
                android:text="🥚  Eggs: 0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded"
                android:elevation="8dp" />


            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />


            <!-- FARM RANK -->
            <TextView
                android:id="@+id/farmRankText"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:background="@drawable/rank_badge_bg"
                android:text="Bronze Farmer"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded"
                android:elevation="8dp" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- CHICKEN FARM AREA -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/chickenArea"
            android:layout_width="0dp"
            android:layout_height="235dp"
            android:layout_marginTop="30dp"
            android:orientation="horizontal"
            android:gravity="bottom"
            app:layout_constraintTop_toBottomOf="@id/topHud"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- SLOT 1 -->
            <FrameLayout
                android:id="@+id/chickenSlot1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">


                <!-- soft ground beneath chicken -->
                <View
                    android:layout_width="100dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/chicken_ground_bg" />


                <ImageView
                    android:id="@+id/chickenImage1"
                    android:layout_width="125dp"
                    android:layout_height="155dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="45dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Chicken slot 1" />


                <TextView
                    android:id="@+id/chickenSlotText1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="Basic Chicken"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-rounded"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="3" />

            </FrameLayout>


            <!-- SLOT 2 -->
            <FrameLayout
                android:id="@+id/chickenSlot2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">


                <View
                    android:layout_width="100dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/chicken_ground_bg" />


                <ImageView
                    android:id="@+id/chickenImage2"
                    android:layout_width="125dp"
                    android:layout_height="155dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="45dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Chicken slot 2" />


                <TextView
                    android:id="@+id/chickenSlotText2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="🔒 Locked"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-rounded"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="3" />

            </FrameLayout>


            <!-- SLOT 3 -->
            <FrameLayout
                android:id="@+id/chickenSlot3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">


                <View
                    android:layout_width="100dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/chicken_ground_bg" />


                <ImageView
                    android:id="@+id/chickenImage3"
                    android:layout_width="125dp"
                    android:layout_height="155dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="45dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Chicken slot 3" />


                <TextView
                    android:id="@+id/chickenSlotText3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="🔒 Locked"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-rounded"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="3" />

            </FrameLayout>

        </LinearLayout>


        <!-- FUTURE DEPLOY POPUP BUTTON -->
        <Button
            android:id="@+id/deployButton"
            android:layout_width="150dp"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/secondary_action_bg"
            android:backgroundTint="@null"
            android:text="🐔  DEPLOY"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-rounded"
            android:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/chickenArea"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ========================= -->
        <!-- PRODUCTION -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/eggsPerSecondText"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/hud_panel_bg"
            android:text="1 egg every 0.5 seconds"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-rounded"
            android:elevation="7dp"
            app:layout_constraintTop_toBottomOf="@id/deployButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ========================= -->
        <!-- CHICKEN CARE PANEL -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/carePanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:orientation="vertical"
            android:background="@drawable/care_panel_bg"
            android:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/eggsPerSecondText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- CARE TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="CHICKEN CARE"
                android:textColor="#FFE1A8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded" />


            <!-- MOOD ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="😊"
                    android:textSize="18sp" />


                <TextView
                    android:id="@+id/moodText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="Mood: 100%"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-rounded" />

            </LinearLayout>


            <ProgressBar
                android:id="@+id/moodBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="100"
                android:progressTint="#6DD36F"
                android:progressBackgroundTint="#53666D" />


            <!-- FEEDER INFORMATION -->
            <TextView
                android:id="@+id/feederText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="🌽  Feeder: 10 / 10"
                android:textColor="#FFF1D2"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded" />


            <!-- MAIN ACTION -->
            <Button
                android:id="@+id/feedButton"
                android:layout_width="230dp"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="9dp"
                android:background="@drawable/primary_action_bg"
                android:backgroundTint="@null"
                android:text="🌽  FEED FLOCK"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded"
                android:elevation="7dp" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- BOTTOM NAVIGATION -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/bottomActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/carePanel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">


            <!-- ROW 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal">


                <Button
                    android:id="@+id/upgradesButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/nav_button_bg"
                    android:backgroundTint="@null"
                    android:text="🔨  UPGRADES"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-rounded"
                    android:elevation="7dp" />


                <Button
                    android:id="@+id/shopButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/nav_button_bg"
                    android:backgroundTint="@null"
                    android:text="🛒  SHOP"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-rounded"
                    android:elevation="7dp" />

            </LinearLayout>


            <!-- ROW 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">


                <Button
                    android:id="@+id/spinButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/spin_nav_button_bg"
                    android:backgroundTint="@null"
                    android:text="🎡  SPIN"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-rounded"
                    android:elevation="8dp" />


                <Button
                    android:id="@+id/rebirthButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/nav_button_bg"
                    android:backgroundTint="@null"
                    android:text="⭐  REBIRTH"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-rounded"
                    android:elevation="7dp" />

            </LinearLayout>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>