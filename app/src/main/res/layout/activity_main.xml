<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/chickeninc_bg"
        android:scaleType="centerCrop"
        android:contentDescription="Farm background" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="58dp"
        android:paddingBottom="32dp">


        <!-- TOP HUD -->

        <LinearLayout
            android:id="@+id/topHud"

            android:layout_width="0dp"
            android:layout_height="58dp"

            android:gravity="center_vertical"
            android:orientation="horizontal"

            android:clipChildren="false"
            android:clipToPadding="false"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="250dp"
                android:layout_height="58dp"
                android:clipChildren="false"
                android:clipToPadding="false">


                <TextView
                    android:id="@+id/eggCountText"
                    style="@style/GameTitle"

                    android:layout_width="226dp"
                    android:layout_height="48dp"

                    android:layout_gravity="center"

                    android:background="@drawable/main_egg_sign_bg"

                    android:elevation="7dp"

                    android:gravity="center"

                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"

                    android:text="🥚 Eggs: 0"

                    android:textColor="#57351F"
                    android:textSize="20sp" />

            </FrameLayout>


            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />


            <TextView
                android:id="@+id/farmRankText"

                style="@style/GameTitle"

                android:layout_width="90dp"
                android:layout_height="48dp"

                android:gravity="center"

                android:paddingStart="8dp"
                android:paddingEnd="8dp"

                android:text="x1"

                android:textColor="#FFFFFF"
                android:textSize="22sp"

                android:shadowColor="#4A2C1A"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="2"

                android:background="@drawable/main_rank_sign_bg"

                android:elevation="7dp" />

        </LinearLayout>


        <!-- CHICKENS -->

        <LinearLayout
            android:id="@+id/chickenArea"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="17dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/topHud"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- SLOT 1 -->

            <FrameLayout
                android:id="@+id/chickenSlot1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">


                <View
                    android:layout_width="92dp"
                    android:layout_height="25dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/chicken_ground_bg" />

                <TextView
                    android:id="@+id/chickenSlotText1"

                    style="@style/GameResponsiveName"

                    android:layout_width="match_parent"
                    android:layout_height="48dp"

                    android:layout_gravity="top|center_horizontal"

                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"

                    android:gravity="center"

                    android:text="Basic Chicken"

                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeMaxTextSize="18sp"

                    android:maxLines="2"

                    android:shadowColor="#FFFFFF"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="4" />

                <ImageView
                android:id="@+id/chickenImage1"

                android:layout_width="135dp"
                android:layout_height="155dp"

                android:layout_gravity="center"

                android:translationY="18dp"

                android:scaleType="fitCenter"

                android:contentDescription="Chicken slot 1" />



            </FrameLayout>


            <!-- SLOT 2 -->

            <FrameLayout
                android:id="@+id/chickenSlot2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">


                <View
                    android:layout_width="92dp"
                    android:layout_height="25dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/chicken_ground_bg" />
                <TextView
                    android:id="@+id/chickenSlotText2"

                    style="@style/GameResponsiveName"

                    android:layout_width="match_parent"
                    android:layout_height="48dp"

                    android:layout_gravity="top|center_horizontal"

                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"

                    android:gravity="center"

                    android:text="🔒 Locked"

                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="18sp"

                    android:maxLines="2"

                    android:shadowColor="#FFFFFF"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="4" />

                <ImageView
                    android:id="@+id/chickenImage2"
                    android:layout_width="125dp"
                    android:layout_height="145dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="43dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Chicken slot 2" />


            </FrameLayout>


            <!-- SLOT 3 -->

            <FrameLayout
                android:id="@+id/chickenSlot3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">


                <View
                    android:layout_width="92dp"
                    android:layout_height="25dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/chicken_ground_bg" />
                <TextView
                    android:id="@+id/chickenSlotText3"

                    style="@style/GameResponsiveName"

                    android:layout_width="match_parent"
                    android:layout_height="48dp"

                    android:layout_gravity="top|center_horizontal"

                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"

                    android:gravity="center"

                    android:text="🔒 Locked"

                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="18sp"

                    android:maxLines="2"

                    android:shadowColor="#FFFFFF"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="4" />

                <ImageView
                    android:id="@+id/chickenImage3"
                    android:layout_width="125dp"
                    android:layout_height="145dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="43dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Chicken slot 3" />




            </FrameLayout>

        </LinearLayout>


        <!-- MANAGE FLOCK -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/deployButton"
            style="@style/GameButtonText"
            android:layout_width="180dp"
            android:layout_height="50dp"
            android:layout_marginTop="3dp"
            android:text="🐔 MANAGE FLOCK"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="@drawable/game_deploy_button_bg"
            android:backgroundTint="@null"
            android:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/chickenArea"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:shadowColor="#60432E"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="2"
            />


        <!-- PRODUCTION -->

        <TextView
            android:id="@+id/eggsPerSecondText"
            style="@style/GameTitle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="1 egg every 1 second"
            android:textColor="#57351F"
            android:textSize="18sp"
            android:background="@drawable/main_small_badge_bg"
            android:elevation="5dp"
            app:layout_constraintTop_toBottomOf="@id/deployButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- CARE -->

        <LinearLayout
            android:id="@+id/carePanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="11dp"
            android:paddingBottom="12dp"
            android:background="@drawable/main_care_panel_bg"
            android:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/eggsPerSecondText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <TextView
                style="@style/GameTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="🐣 CHICKEN CARE"
                android:textColor="#7A481F"
                android:textSize="16sp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical">


                <TextView
                    android:id="@+id/moodText"
                    style="@style/GameText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="😊 Mood: 100%"
                    android:textColor="#57351F"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/feederText"
                    style="@style/GameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌽 10 / 10"
                    android:textColor="#57351F"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <ProgressBar
                android:id="@+id/moodBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="100"
                android:progressTint="#71D34F"
                android:progressBackgroundTint="#E4C98B" />


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/feedButton"
                style="@style/GameButtonText"
                android:layout_width="225dp"
                android:layout_height="54dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="9dp"
                android:text="🌽 FEED FLOCK"
                android:textColor="#57351F"
                android:textSize="22sp"
                android:background="@drawable/game_upgrade_button_bg"
                android:backgroundTint="@null"
                android:elevation="7dp" />

        </LinearLayout>


        <!-- BOTTOM BUTTONS -->

        <LinearLayout
            android:id="@+id/bottomButtons"
            android:layout_width="0dp"
            android:layout_height="116dp"
            android:layout_marginTop="11dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/carePanel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:orientation="horizontal">


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/upgradesButton"
                    style="@style/GameButtonText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="🔨 UPGRADES"
                    android:textColor="#57351F"
                    android:textSize="18sp"
                    android:background="@drawable/game_upgrade_button_bg"
                    android:backgroundTint="@null"
                    android:shadowColor="#60432E"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="2"/>


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/shopButton"
                    style="@style/GameButtonText"

                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"

                    android:layout_marginStart="5dp"

                    android:text="🛒 SHOP"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"

                    android:background="@drawable/game_buy_button_bg"

                    app:backgroundTint="@null"
                    android:shadowColor="#60432E"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="2"
                    />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/spinButton"
                    style="@style/GameButtonText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="🎡 SPIN"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:background="@drawable/main_spin_button_bg"
                    android:backgroundTint="@null"
                    android:shadowColor="#60432E"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="2"/>


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/rebirthButton"
                    style="@style/GameButtonText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="⭐ REBIRTH"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:background="@drawable/main_rebirth_button_bg"
                    android:backgroundTint="@null"
                    android:shadowColor="#60432E"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="2"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/homeButton"
                    style="@style/GameButtonText"

                    android:layout_width="52dp"
                    android:layout_height="48dp"

                    android:text="⌂"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"

                    android:background="@drawable/game_back_button_bg"
                    android:elevation="9dp"

                    app:backgroundTint="@null"

                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>