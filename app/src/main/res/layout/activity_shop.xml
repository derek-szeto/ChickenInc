<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- FARM BACKGROUND -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/default_bg"
        android:scaleType="centerCrop"
        android:contentDescription="Farm background" />


    <!-- Slight dim so shop stays readable -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="55dp"
        android:paddingBottom="35dp">


        <!-- ================================= -->
        <!-- WOOD SHOP HEADER -->
        <!-- ================================= -->

        <LinearLayout
            android:id="@+id/shopHeader"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:background="@drawable/shop_wood_header_bg"
            android:elevation="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <TextView
                android:id="@+id/shopTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🐔 Chicken Shop"
                android:textColor="#FFF7DF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded"
                android:shadowColor="#66351D"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2" />


            <TextView
                android:id="@+id/shopEggText"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:gravity="center"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:text="🥚 172"
                android:textColor="#57351F"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded"
                android:background="@drawable/shop_egg_badge_bg" />


            <Button
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/shop_close_bg"
                android:backgroundTint="@null" />

        </LinearLayout>


        <!-- ================================= -->
        <!-- SHOP TABS -->
        <!-- ================================= -->

        <LinearLayout
            android:id="@+id/shopTabs"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="@drawable/shop_tab_container_bg"
            app:layout_constraintTop_toBottomOf="@id/shopHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <Button
                android:id="@+id/chickensTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="🐔  CHICKENS"
                android:textColor="#57351F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded"
                android:background="@drawable/shop_tab_selected_bg"
                android:backgroundTint="@null" />


            <Button
                android:id="@+id/gadgetsTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="⚡  GADGETS"
                android:textColor="#57351F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded"
                android:background="@drawable/shop_tab_unselected_bg"
                android:backgroundTint="@null" />

        </LinearLayout>


        <!-- ================================= -->
        <!-- MAIN SHOP PANEL -->
        <!-- ================================= -->

        <FrameLayout
            android:id="@+id/shopContentArea"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/shop_main_panel_bg"
            android:elevation="7dp"
            app:layout_constraintTop_toBottomOf="@id/shopTabs"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- ================================= -->
            <!-- CHICKEN SHOP -->
            <!-- ================================= -->

            <LinearLayout
                android:id="@+id/chickensContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp">


                <!-- SELECTED CHICKEN -->
                <LinearLayout
                    android:id="@+id/previewPanel"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:padding="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/shop_preview_bg">


                    <!-- IMAGE AREA -->
                    <FrameLayout
                        android:layout_width="135dp"
                        android:layout_height="150dp">


                        <View
                            android:layout_width="105dp"
                            android:layout_height="26dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/chicken_ground_bg" />


                        <ImageView
                            android:id="@+id/previewImage"
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:contentDescription="Selected chicken" />

                    </FrameLayout>


                    <!-- CHICKEN INFORMATION -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/previewName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Basic Chicken"
                            android:textColor="#57351F"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-rounded" />


                        <TextView
                            android:id="@+id/previewRarity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Common"
                            android:textColor="#9A9A92"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-rounded" />


                        <TextView
                            android:id="@+id/previewStats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Base: 1   Max Level: 5\nMax Multiplier: x2.0"
                            android:textColor="#69462D"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:fontFamily="sans-serif-rounded" />


                        <TextView
                            android:id="@+id/previewPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Owned • Active"
                            android:textColor="#3FB85A"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-rounded" />


                        <!-- BUTTON ROW -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="7dp"
                            android:orientation="horizontal">


                            <Button
                                android:id="@+id/buyButton"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:text="BUY"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-rounded"
                                android:background="@drawable/shop_buy_button_bg"
                                android:backgroundTint="@null" />


                            <!-- We'll wire this to the deployment popup next -->
                            <Button
                                android:id="@+id/deployButton"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:text="DEPLOY"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-rounded"
                                android:background="@drawable/shop_deploy_button_bg"
                                android:backgroundTint="@null" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


                <!-- SECTION LABEL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp"
                    android:text="Your Chicken Catalog"
                    android:textColor="#57351F"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-rounded" />


                <!-- CHICKEN GRID -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="false"
                    android:scrollbars="none">


                    <GridLayout
                        android:id="@+id/chickenGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:alignmentMode="alignMargins"
                        android:useDefaultMargins="true" />

                </ScrollView>

            </LinearLayout>


            <!-- ================================= -->
            <!-- GADGETS PLACEHOLDER -->
            <!-- ================================= -->

            <LinearLayout
                android:id="@+id/gadgetsContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="25dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡"
                    android:textSize="72sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Farm Gadgets"
                    android:textColor="#57351F"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-rounded" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Unlimited Feeder\nUnlimited Mood\nExtra Spin Rolls"
                    android:textColor="#795638"
                    android:textSize="17sp"
                    android:lineSpacingExtra="8dp"
                    android:fontFamily="sans-serif-rounded" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="Coming Soon!"
                    android:textColor="#F6A63A"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-rounded" />

            </LinearLayout>


        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>