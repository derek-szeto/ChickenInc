<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/default_bg"
        android:scaleType="centerCrop"
        android:contentDescription="Farm background" />


    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22000000" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="55dp"
        android:paddingBottom="32dp">


        <!-- BACK -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/backButton"

            style="@style/GameButtonText"

            android:layout_width="108dp"
            android:layout_height="48dp"

            android:text="←  BACK"
            android:textColor="#FFFFFF"
            android:textSize="15sp"

            android:background="@drawable/game_back_button_bg"

            app:backgroundTint="@null"

            android:elevation="9dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- HEADER -->

        <LinearLayout
            android:id="@+id/shopHeader"

            android:layout_width="0dp"
            android:layout_height="64dp"

            android:layout_marginTop="12dp"

            android:gravity="center_vertical"

            android:orientation="horizontal"

            android:paddingStart="15dp"
            android:paddingEnd="15dp"

            android:background="@drawable/shop_wood_header_bg"

            android:elevation="10dp"

            app:layout_constraintTop_toBottomOf="@id/backButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <TextView
                android:id="@+id/shopTitleText"

                style="@style/GameTitle"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="🐔 CHICKEN SHOP!"

                android:textColor="#FFF7DF"

                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="17sp"
                android:autoSizeMaxTextSize="23sp"
                android:autoSizeStepGranularity="1sp"

                android:maxLines="1"

                android:shadowColor="#66351D"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2" />


            <TextView
                android:id="@+id/shopEggText"

                style="@style/GameTitle"

                android:layout_width="88dp"
                android:layout_height="42dp"

                android:gravity="center"

                android:paddingStart="8dp"
                android:paddingEnd="8dp"

                android:text="🥚 172"
                android:textColor="#57351F"

                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeStepGranularity="1sp"

                android:background="@drawable/shop_egg_badge_bg" />

        </LinearLayout>


        <!-- TABS -->

        <LinearLayout
            android:id="@+id/shopTabs"

            android:layout_width="0dp"
            android:layout_height="56dp"

            android:layout_marginTop="10dp"

            android:orientation="horizontal"

            android:padding="4dp"

            android:background="@drawable/shop_tab_container_bg"

            app:layout_constraintTop_toBottomOf="@id/shopHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/chickensTab"

                style="@style/GameButtonText"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:layout_marginEnd="4dp"

                android:text="🐔 CHICKENS"

                android:textColor="#57351F"
                android:textSize="14sp"

                android:background="@drawable/shop_tab_selected_bg"

                app:backgroundTint="@null" />


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/gadgetsTab"

                style="@style/GameButtonText"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:layout_marginStart="4dp"

                android:text="⚡ GADGETS"

                android:textColor="#57351F"
                android:textSize="14sp"

                android:background="@drawable/shop_tab_unselected_bg"

                app:backgroundTint="@null" />

        </LinearLayout>


        <!-- CONTENT -->

        <FrameLayout
            android:id="@+id/shopContentArea"

            android:layout_width="0dp"
            android:layout_height="0dp"

            android:layout_marginTop="9dp"

            android:background="@drawable/shop_main_panel_bg"

            android:elevation="7dp"

            android:clipChildren="false"

            app:layout_constraintTop_toBottomOf="@id/shopTabs"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- CHICKEN CONTENT -->

            <LinearLayout
                android:id="@+id/chickensContent"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:orientation="vertical"

                android:padding="12dp">


                <!-- SELECTED CHICKEN -->

                <LinearLayout
                    android:id="@+id/previewPanel"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:minHeight="215dp"

                    android:padding="12dp"

                    android:orientation="horizontal"
                    android:gravity="center_vertical"

                    android:background="@drawable/shop_preview_bg">


                    <!-- IMAGE -->

                    <FrameLayout
                        android:layout_width="135dp"
                        android:layout_height="155dp"

                        android:clipChildren="false">


                        <View
                            android:layout_width="105dp"
                            android:layout_height="26dp"

                            android:layout_gravity="bottom|center_horizontal"

                            android:layout_marginBottom="8dp"

                            android:background="@drawable/chicken_ground_bg" />


                        <ImageView
                            android:id="@+id/previewImage"

                            android:layout_width="130dp"
                            android:layout_height="135dp"

                            android:layout_gravity="center"

                            android:scaleType="fitCenter"

                            android:contentDescription="Selected chicken" />

                    </FrameLayout>


                    <!-- INFO -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:layout_marginStart="10dp"

                        android:orientation="vertical"

                        android:gravity="center_vertical">


                        <TextView
                            android:id="@+id/previewName"

                            style="@style/GameResponsiveName"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:minHeight="50dp"

                            android:gravity="start|center_vertical"

                            android:text="Basic Chicken"

                            android:textColor="#57351F"

                            android:autoSizeMinTextSize="12sp"
                            android:autoSizeMaxTextSize="21sp"

                            android:maxLines="2" />


                        <TextView
                            android:id="@+id/previewRarity"

                            style="@style/GameTitle"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="1dp"

                            android:text="Common"

                            android:textColor="#9A9A92"

                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="10sp"
                            android:autoSizeMaxTextSize="15sp"
                            android:autoSizeStepGranularity="1sp"

                            android:maxLines="1" />


                        <TextView
                            android:id="@+id/previewStats"

                            style="@style/GameText"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="5dp"

                            android:text="Base Production: 1&#10;Max Level: 5&#10;Max Multiplier: x2.0"

                            android:textColor="#69462D"

                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="9sp"
                            android:autoSizeMaxTextSize="13sp"
                            android:autoSizeStepGranularity="1sp"

                            android:maxLines="3"

                            android:lineSpacingExtra="1dp" />


                        <TextView
                            android:id="@+id/previewPrice"

                            style="@style/GameTitle"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="5dp"

                            android:text="Owned • Active"

                            android:textColor="#3FB85A"

                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="10sp"
                            android:autoSizeMaxTextSize="14sp"
                            android:autoSizeStepGranularity="1sp"

                            android:maxLines="1" />


                        <!-- BUTTONS -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"

                            android:layout_marginTop="6dp"

                            android:orientation="horizontal">


                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/buyButton"

                                style="@style/GameButtonText"

                                android:layout_width="0dp"
                                android:layout_height="match_parent"

                                android:layout_weight="1"

                                android:layout_marginEnd="4dp"

                                android:text="BUY"

                                android:textColor="#FFFFFF"

                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="9sp"
                                android:autoSizeMaxTextSize="13sp"
                                android:autoSizeStepGranularity="1sp"

                                android:background="@drawable/game_buy_button_bg"

                                app:backgroundTint="@null" />


                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/deployButton"

                                style="@style/GameButtonText"

                                android:layout_width="0dp"
                                android:layout_height="match_parent"

                                android:layout_weight="1"

                                android:layout_marginStart="4dp"

                                android:text="DEPLOY"

                                android:textColor="#FFFFFF"

                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="8sp"
                                android:autoSizeMaxTextSize="12sp"
                                android:autoSizeStepGranularity="1sp"

                                android:background="@drawable/game_deploy_button_bg"

                                app:backgroundTint="@null" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


                <!-- CATALOG TITLE -->

                <TextView
                    style="@style/GameTitle"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="9dp"
                    android:layout_marginBottom="4dp"

                    android:text="🐣 CHICKEN CATALOG"

                    android:textColor="#57351F"

                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="13sp"
                    android:autoSizeMaxTextSize="18sp"
                    android:autoSizeStepGranularity="1sp"

                    android:maxLines="1" />


                <!-- GRID -->

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"

                    android:layout_weight="1"

                    android:scrollbars="none">


                    <GridLayout
                        android:id="@+id/chickenGrid"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:columnCount="2"

                        android:alignmentMode="alignMargins"

                        android:useDefaultMargins="true" />

                </ScrollView>

            </LinearLayout>


            <!-- GADGETS -->

            <LinearLayout
                android:id="@+id/gadgetsContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <TextView
                    style="@style/GameTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="⚡ FARM GADGETS!"
                    android:textColor="#57351F"
                    android:textSize="27sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp"
                    android:background="@drawable/shop_preview_bg">

                    <TextView
                        style="@style/GameTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌽 FEEDER RESTOCK"
                        android:textColor="#57351F"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/feederStockText"
                        style="@style/GameTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="Food: 10 / 10"
                        android:textColor="#57351F"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/feederRestockCostText"
                        style="@style/GameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="Restock Cost: 🥚 0"
                        android:textColor="#795638"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/restockFeederButton"
                        style="@style/GameButtonText"
                        android:layout_width="240dp"
                        android:layout_height="58dp"
                        android:layout_marginTop="14dp"
                        android:text="🌽 RESTOCK"
                        android:textColor="#57351F"
                        android:textSize="19sp"
                        android:background="@drawable/game_upgrade_button_bg"
                        android:elevation="7dp"
                        app:backgroundTint="@null" />

                </LinearLayout>

                <TextView
                    style="@style/GameTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="MORE GADGETS"
                    android:textColor="#57351F"
                    android:textSize="20sp" />

                <TextView
                    style="@style/GameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="⚡ Unlimited Feeder&#10;😊 Unlimited Mood&#10;🎡 Extra Spin Rolls"
                    android:textColor="#795638"
                    android:textSize="17sp"
                    android:lineSpacingExtra="8dp" />

                <TextView
                    style="@style/GameTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="COMING SOON!"
                    android:textColor="#D98524"
                    android:textSize="20sp" />

            </LinearLayout>


        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>