<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- FARM BACKGROUND -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/default_bg"
        android:scaleType="centerCrop" />


    <!-- Slight dark overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        android:paddingTop="45dp"
        android:paddingBottom="45dp">


        <!-- BACK -->
        <Button
            android:id="@+id/backButton"
            android:layout_width="55dp"
            android:layout_height="50dp"
            android:text="←"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/close_button_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


        <!-- TITLE -->
        <TextView
            android:id="@+id/spinTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LUCKY WHEEL!"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFF176"
            android:shadowColor="#E65100"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <TextView
            android:id="@+id/wheelInfoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7 CHICKENS + 1 GADGET"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/game_info_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/spinTitleText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- TIMER -->
        <TextView
            android:id="@+id/spinTimerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FREE SPIN READY!"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/game_info_bg"
            android:padding="8dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/wheelInfoText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- WHEEL -->
        <FrameLayout
            android:id="@+id/wheelArea"
            android:layout_width="330dp"
            android:layout_height="330dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/spinTimerText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <com.example.chickeninc.PrizeWheelView
                android:id="@+id/prizeWheelView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />


            <!-- Fixed pointer -->
            <TextView
                android:id="@+id/wheelPointer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:translationY="-3dp"
                android:text="▼"
                android:textSize="44sp"
                android:textStyle="bold"
                android:textColor="#FF1744"
                android:elevation="25dp"
                android:shadowColor="#FFFFFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="5" />

        </FrameLayout>


        <!-- SPIN -->
        <Button
            android:id="@+id/spinButton"
            android:layout_width="220dp"
            android:layout_height="65dp"
            android:layout_marginTop="14dp"
            android:text="SPIN!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/spin_button_bg"
            android:elevation="12dp"
            app:layout_constraintTop_toBottomOf="@id/wheelArea"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- RESULT -->
        <TextView
            android:id="@+id/resultText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Tap SPIN to win!"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/game_info_bg"
            android:padding="10dp"
            app:layout_constraintTop_toBottomOf="@id/spinButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>