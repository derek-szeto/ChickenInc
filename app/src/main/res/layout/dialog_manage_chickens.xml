<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"

    android:padding="18dp"

    android:background="@drawable/deploy_popup_bg">


    <TextView
        style="@style/GameTitle"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center"

        android:text="🐔 MANAGE FLOCK"

        android:textColor="#57351F"
        android:textSize="24sp" />


    <TextView
        android:id="@+id/deploySlotStatusText"

        style="@style/GameText"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="5dp"

        android:gravity="center"

        android:text="1 / 3 Chickens Deployed"

        android:textColor="#795638"
        android:textSize="14sp"

        android:textStyle="bold" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="400dp"

        android:layout_marginTop="12dp"

        android:scrollbars="none">


        <LinearLayout
            android:id="@+id/ownedChickenContainer"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical" />

    </ScrollView>


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/closeDeployManagerButton"

        style="@style/GameButtonText"

        android:layout_width="190dp"
        android:layout_height="52dp"

        android:layout_gravity="center_horizontal"

        android:layout_marginTop="12dp"

        android:text="CLOSE"

        android:textColor="#FFFFFF"
        android:textSize="14sp"

        android:background="@drawable/game_back_button_bg"

        app:backgroundTint="@null" />

</LinearLayout>