<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- ========================= -->
    <!-- FARM BACKGROUND -->
    <!-- ========================= -->

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/default_bg"
        android:scaleType="centerCrop"
        android:contentDescription="Farm background" />


    <!-- DARK OVERLAY -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6608141B" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="55dp"
        android:paddingBottom="35dp">


        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <Button
            android:id="@+id/backButton"
            android:layout_width="58dp"
            android:layout_height="46dp"
            android:text="←"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-rounded"
            android:background="@drawable/nav_button_bg"
            android:backgroundTint="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/upgradesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPGRADES"
            android:textColor="#FFF1D2"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-rounded"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            app:layout_constraintTop_toTopOf="@id/backButton"
            app:layout_constraintBottom_toBottomOf="@id/backButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <TextView
            android:id="@+id/eggCountText"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="🥚 172"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:fontFamily="sans-serif-rounded"
            android:background="@drawable/hud_panel_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/backButton"
            app:layout_constraintBottom_toBottomOf="@id/backButton" />


        <!-- ========================= -->
        <!-- UPGRADE CATEGORY TABS -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/upgradeTabs"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:background="@drawable/upgrade_tab_container_bg"
            android:padding="4dp"
            app:layout_constraintTop_toBottomOf="@id/backButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <Button
                android:id="@+id/chickenUpgradeTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🐔 CHICKENS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-rounded"
                android:background="@drawable/upgrade_tab_selected_bg"
                android:backgroundTint="@null" />


            <Button
                android:id="@+id/feederUpgradeTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🌽 FEEDER"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-rounded"
                android:background="@android:color/transparent"
                android:backgroundTint="@null" />


            <Button
                android:id="@+id/slotUpgradeTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🏡 SLOTS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-rounded"
                android:background="@android:color/transparent"
                android:backgroundTint="@null" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- CONTENT AREA -->
        <!-- ========================= -->

        <FrameLayout
            android:id="@+id/upgradeContentArea"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/upgradeTabs"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- ================================= -->
            <!-- CHICKEN UPGRADES -->
            <!-- ================================= -->

            <ScrollView
                android:id="@+id/chickenUpgradeContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="20dp">


                    <!-- CHICKEN SELECTOR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="82dp"
                        android:orientation="horizontal"
                        android:gravity="center">


                        <Button
                            android:id="@+id/chicken1Button"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:text="Basic"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-rounded"
                            android:background="@drawable/chicken_selector_selected_bg"
                            android:backgroundTint="@null" />


                        <Button
                            android:id="@+id/chicken2Button"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            android:text="Ruby"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-rounded"
                            android:background="@drawable/chicken_selector_bg"
                            android:backgroundTint="@null" />


                        <Button
                            android:id="@+id/chicken3Button"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:text="Locked"
                            android:textColor="#AAB7BD"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-rounded"
                            android:background="@drawable/chicken_selector_bg"
                            android:backgroundTint="@null" />

                    </LinearLayout>


                    <!-- MAIN CHICKEN CARD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="18dp"
                        android:background="@drawable/upgrade_card_bg">


                        <!-- CHICKEN IMAGE -->
                        <ImageView
                            android:id="@+id/upgradeChickenImage"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="Selected chicken" />


                        <!-- NAME -->
                        <TextView
                            android:id="@+id/chickenNameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Basic Chicken"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-rounded" />


                        <!-- RARITY -->
                        <TextView
                            android:id="@+id/rarityText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Common"
                            android:textColor="#B0BEC5"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-rounded" />


                        <!-- LEVEL -->
                        <TextView
                            android:id="@+id/levelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:text="Level 0 / 5"
                            android:textColor="#FFF1D2"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-rounded" />


                        <!-- STAT PANEL -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="@drawable/stats_panel_bg">


                            <TextView
                                android:id="@+id/multiplierText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Multiplier        x1.0"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:fontFamily="sans-serif-rounded" />


                            <TextView
                                android:id="@+id/productionText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="Production        1 egg"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:fontFamily="sans-serif-rounded" />


                            <!-- Future preview -->
                            <TextView
                                android:id="@+id/nextUpgradeText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:text="Next Upgrade:  x1.0 → x1.2"
                                android:textColor="#79DC7C"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-rounded" />

                        </LinearLayout>


                        <TextView
                            android:id="@+id/upgradeCostText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Upgrade Cost: 🥚 100"
                            android:textColor="#FFF1D2"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-rounded" />


                        <Button
                            android:id="@+id/upgradeButton"
                            android:layout_width="230dp"
                            android:layout_height="56dp"
                            android:layout_marginTop="12dp"
                            android:text="UPGRADE"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-rounded"
                            android:background="@drawable/primary_action_bg"
                            android:backgroundTint="@null" />

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>


            <!-- ================================= -->
            <!-- FEEDER UPGRADES -->
            <!-- ================================= -->

            <ScrollView
                android:id="@+id/feederUpgradeContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="18dp"
                    android:background="@drawable/upgrade_card_bg">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌽"
                        android:textSize="70sp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Feeder"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-rounded" />


                    <TextView
                        android:id="@+id/feederLevelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Feeder Level: 1 / 5"
                        android:textColor="#FFF1D2"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-rounded" />


                    <!-- LEVEL DOTS -->
                    <TextView
                        android:id="@+id/feederLevelDots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="●  ○  ○  ○  ○"
                        android:textColor="#F5B83D"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-rounded" />


                    <TextView
                        android:id="@+id/feederStatsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:padding="14dp"
                        android:gravity="center"
                        android:background="@drawable/stats_panel_bg"
                        android:text="Capacity: 10 → 18\nServing: 1 → 2\nMood Per Feed: +15 → +20"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:lineSpacingExtra="7dp"
                        android:fontFamily="sans-serif-rounded" />


                    <Button
                        android:id="@+id/upgradeFeederButton"
                        android:layout_width="240dp"
                        android:layout_height="58dp"
                        android:layout_marginTop="20dp"
                        android:text="UPGRADE  •  🥚 1K"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-rounded"
                        android:background="@drawable/primary_action_bg"
                        android:backgroundTint="@null" />

                </LinearLayout>

            </ScrollView>


            <!-- ================================= -->
            <!-- SLOT UPGRADES -->
            <!-- ================================= -->

            <ScrollView
                android:id="@+id/slotUpgradeContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="18dp"
                    android:background="@drawable/upgrade_card_bg">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Farm Slots"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-rounded" />


                    <TextView
                        android:id="@+id/slotCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="1 / 3 Slots Unlocked"
                        android:textColor="#FFF1D2"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-rounded" />


                    <!-- SLOT GRAPHIC -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal"
                        android:gravity="center">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_weight="1"
                            android:layout_margin="5dp"
                            android:gravity="center"
                            android:text="🐔&#10;SLOT 1&#10;UNLOCKED"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:background="@drawable/slot_unlocked_bg" />


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_weight="1"
                            android:layout_margin="5dp"
                            android:gravity="center"
                            android:text="🔒&#10;SLOT 2"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:background="@drawable/slot_locked_bg" />


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_weight="1"
                            android:layout_margin="5dp"
                            android:gravity="center"
                            android:text="🔒&#10;SLOT 3"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:background="@drawable/slot_locked_bg" />

                    </LinearLayout>


                    <TextView
                        android:id="@+id/nextSlotText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Unlock Slot 2"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-rounded" />


                    <TextView
                        android:id="@+id/slotUpgradeCostText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Cost: 🥚 5K"
                        android:textColor="#FFF1D2"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    <Button
                        android:id="@+id/upgradeSlotButton"
                        android:layout_width="240dp"
                        android:layout_height="58dp"
                        android:layout_marginTop="18dp"
                        android:text="UNLOCK SLOT"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-rounded"
                        android:background="@drawable/primary_action_bg"
                        android:backgroundTint="@null" />

                </LinearLayout>

            </ScrollView>


        </FrameLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>