<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- BACKGROUND -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/default_bg"
        android:scaleType="centerCrop"
        android:contentDescription="Farm background" />


    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22000000" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="55dp"
        android:paddingBottom="32dp">


        <!-- ================================= -->
        <!-- HEADER -->
        <!-- ================================= -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/upgradeHeader"
            android:layout_width="0dp"
            android:layout_height="50dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/backButton"
                style="@style/GameButtonText"

                android:layout_width="108dp"
                android:layout_height="48dp"

                android:text="←  BACK"
                android:textColor="#FFFFFF"
                android:textSize="15sp"

                android:background="@drawable/game_back_button_bg"
                app:backgroundTint="@null"

                android:elevation="9dp"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


            <TextView
                android:id="@+id/eggCountText"
                style="@style/GameTitle"

                android:layout_width="88dp"
                android:layout_height="44dp"

                android:gravity="center"

                android:text="🥚 172"
                android:textColor="#57351F"

                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeStepGranularity="1sp"

                android:background="@drawable/main_egg_sign_bg"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- TITLE -->

        <TextView
            android:id="@+id/upgradesTitle"
            style="@style/GameTitle"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="7dp"

            android:gravity="center"

            android:text="FARM UPGRADES"
            android:textColor="#FFD34E"
            android:textSize="28sp"

            android:shadowColor="#8A4E27"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2"

            app:layout_constraintTop_toBottomOf="@id/upgradeHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================= -->
        <!-- TABS -->
        <!-- ================================= -->

        <LinearLayout
            android:id="@+id/upgradeTabs"

            android:layout_width="0dp"
            android:layout_height="58dp"

            android:layout_marginTop="10dp"

            android:orientation="horizontal"
            android:padding="4dp"

            android:background="@drawable/shop_tab_container_bg"

            app:layout_constraintTop_toBottomOf="@id/upgradesTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/chickenUpgradeTab"
                style="@style/GameButtonText"

                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"

                android:layout_marginEnd="3dp"

                android:text="🐔 CHICKENS"
                android:textSize="14sp"
                android:textColor="#57351F"

                android:background="@drawable/shop_tab_selected_bg"
                app:backgroundTint="@null" />


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/feederUpgradeTab"
                style="@style/GameButtonText"

                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"

                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"

                android:text="🌽 FEEDER"
                android:textSize="14sp"
                android:textColor="#57351F"

                android:background="@drawable/shop_tab_unselected_bg"
                app:backgroundTint="@null" />


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/slotUpgradeTab"
                style="@style/GameButtonText"

                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"

                android:layout_marginStart="3dp"

                android:text="🏡 SLOTS"
                android:textSize="14sp"
                android:textColor="#FFFFFF"

                android:background="@drawable/game_buy_button_bg"
                app:backgroundTint="@null" />

        </LinearLayout>


        <!-- ================================= -->
        <!-- CONTENT -->
        <!-- ================================= -->

        <FrameLayout
            android:id="@+id/upgradeContentArea"

            android:layout_width="0dp"
            android:layout_height="0dp"

            android:layout_marginTop="10dp"

            app:layout_constraintTop_toBottomOf="@id/upgradeTabs"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- ================================================= -->
            <!-- CHICKEN UPGRADES -->
            <!-- ================================================= -->

            <ScrollView
                android:id="@+id/chickenUpgradeContent"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:fillViewport="true"
                android:scrollbars="none">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:paddingBottom="20dp">


                    <!-- OWNED CHICKEN SELECTOR -->

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="78dp"

                        android:scrollbars="none"
                        android:fillViewport="false">


                        <LinearLayout
                            android:id="@+id/ownedChickenSelector"

                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"

                            android:orientation="horizontal"
                            android:gravity="center_vertical"

                            android:paddingStart="3dp"
                            android:paddingEnd="3dp" />

                    </HorizontalScrollView>


                    <!-- MAIN CHICKEN CARD -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="vertical"
                        android:gravity="center_horizontal"

                        android:padding="17dp"

                        android:background="@drawable/shop_preview_bg">


                        <ImageView
                            android:id="@+id/upgradeChickenImage"

                            android:layout_width="150dp"
                            android:layout_height="150dp"

                            android:scaleType="fitCenter"

                            android:contentDescription="Selected chicken" />


                        <TextView
                            android:id="@+id/chickenNameText"

                            style="@style/GameResponsiveName"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:minHeight="52dp"

                            android:layout_marginTop="5dp"

                            android:gravity="center"

                            android:text="Basic Chicken"
                            android:textColor="#57351F"

                            android:autoSizeMinTextSize="15sp"
                            android:autoSizeMaxTextSize="23sp"

                            android:maxLines="2" />


                        <TextView
                            android:id="@+id/rarityText"

                            style="@style/GameTitle"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="2dp"

                            android:text="Common"
                            android:textColor="#9A9A92"
                            android:textSize="15sp" />


                        <TextView
                            android:id="@+id/levelText"

                            style="@style/GameTitle"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="12dp"

                            android:text="Level 0 / 5"
                            android:textColor="#57351F"
                            android:textSize="18sp" />


                        <!-- STATS -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="10dp"

                            android:orientation="vertical"

                            android:padding="12dp"

                            android:background="@drawable/main_small_badge_bg">


                            <TextView
                                android:id="@+id/multiplierText"

                                style="@style/GameText"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:text="Multiplier        x1.0"
                                android:textColor="#57351F"
                                android:textSize="17sp" />


                            <TextView
                                android:id="@+id/productionText"

                                style="@style/GameText"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="6dp"

                                android:text="Production        1 egg"
                                android:textColor="#57351F"
                                android:textSize="17sp" />


                            <TextView
                                android:id="@+id/nextUpgradeText"

                                style="@style/GameTitle"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="8dp"

                                android:maxLines="2"

                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="12sp"
                                android:autoSizeMaxTextSize="17sp"
                                android:autoSizeStepGranularity="1sp"

                                android:text="Next: x1.0 → x1.2 • 1 → 1 eggs"
                                android:textColor="#3FB85A" />

                        </LinearLayout>


                        <TextView
                            android:id="@+id/upgradeCostText"

                            style="@style/GameTitle"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="14dp"

                            android:gravity="center"

                            android:text="Upgrade Cost: 🥚 100"
                            android:textColor="#57351F"

                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="12sp"
                            android:autoSizeMaxTextSize="16sp"
                            android:autoSizeStepGranularity="1sp" />


                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/upgradeButton"

                            style="@style/GameButtonText"

                            android:layout_width="240dp"
                            android:layout_height="58dp"

                            android:layout_marginTop="11dp"

                            android:text="UPGRADE"
                            android:textColor="#57351F"
                            android:textSize="22sp"

                            android:background="@drawable/game_upgrade_button_bg"

                            app:backgroundTint="@null" />

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>


            <!-- ================================================= -->
            <!-- FEEDER -->
            <!-- ================================================= -->

            <ScrollView
                android:id="@+id/feederUpgradeContent"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:visibility="gone"

                android:fillViewport="true"
                android:scrollbars="none">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"
                    android:gravity="center_horizontal"

                    android:padding="18dp"

                    android:background="@drawable/shop_preview_bg">


                    <TextView
                        style="@style/GameTitle"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="🌽"
                        android:textSize="68sp" />


                    <TextView
                        style="@style/GameTitle"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="FEEDER"
                        android:textColor="#57351F"
                        android:textSize="28sp" />


                    <TextView
                        android:id="@+id/feederLevelText"

                        style="@style/GameTitle"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:gravity="center"

                        android:text="Feeder Level: 1 / 5"
                        android:textColor="#57351F"
                        android:textSize="17sp" />


                    <TextView
                        android:id="@+id/feederLevelDots"

                        style="@style/GameTitle"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:text="●  ○  ○  ○  ○"
                        android:textColor="#F6A63A"
                        android:textSize="22sp" />


                    <TextView
                        android:id="@+id/feederStatsText"

                        style="@style/GameText"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="14dp"

                        android:padding="14dp"

                        android:gravity="center"

                        android:background="@drawable/main_small_badge_bg"

                        android:text="Capacity: 10 → 18\nServing: 1 → 2\nMood Per Feed: +15 → +20"

                        android:textColor="#57351F"
                        android:textSize="18sp"

                        android:lineSpacingExtra="7dp" />


                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/upgradeFeederButton"

                        style="@style/GameButtonText"

                        android:layout_width="250dp"
                        android:layout_height="58dp"

                        android:layout_marginTop="18dp"

                        android:text="UPGRADE • 🥚 1K"

                        android:textColor="#57351F"

                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeMaxTextSize="20sp"
                        android:autoSizeStepGranularity="1sp"

                        android:background="@drawable/game_upgrade_button_bg"

                        app:backgroundTint="@null" />

                </LinearLayout>

            </ScrollView>


            <!-- ================================================= -->
            <!-- SLOT UPGRADES -->
            <!-- ================================================= -->

            <ScrollView
                android:id="@+id/slotUpgradeContent"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:visibility="gone"

                android:fillViewport="true"
                android:scrollbars="none">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"
                    android:gravity="center_horizontal"

                    android:padding="18dp"

                    android:background="@drawable/shop_preview_bg">


                    <TextView
                        style="@style/GameTitle"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center"

                        android:text="🏡 FARM SLOTS"
                        android:textColor="#57351F"
                        android:textSize="28sp" />


                    <TextView
                        android:id="@+id/slotCountText"

                        style="@style/GameTitle"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"

                        android:gravity="center"

                        android:text="1 / 3 Slots Unlocked"
                        android:textColor="#57351F"
                        android:textSize="19sp" />


                    <!-- SLOT CARDS -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="130dp"

                        android:layout_marginTop="20dp"

                        android:orientation="horizontal"
                        android:gravity="center">


                        <TextView
                            android:id="@+id/slot1CardText"

                            style="@style/GameTitle"

                            android:layout_width="0dp"
                            android:layout_height="100dp"

                            android:layout_weight="1"
                            android:layout_margin="5dp"

                            android:gravity="center"

                            android:text="🐔&#10;SLOT 1&#10;UNLOCKED"

                            android:textColor="#FFFFFF"
                            android:textSize="12sp"

                            android:background="@drawable/slot_unlocked_bg" />


                        <TextView
                            android:id="@+id/slot2CardText"

                            style="@style/GameTitle"

                            android:layout_width="0dp"
                            android:layout_height="100dp"

                            android:layout_weight="1"
                            android:layout_margin="5dp"

                            android:gravity="center"

                            android:text="🔒&#10;SLOT 2&#10;LOCKED"

                            android:textColor="#FFFFFF"
                            android:textSize="12sp"

                            android:background="@drawable/slot_locked_bg" />


                        <TextView
                            android:id="@+id/slot3CardText"

                            style="@style/GameTitle"

                            android:layout_width="0dp"
                            android:layout_height="100dp"

                            android:layout_weight="1"
                            android:layout_margin="5dp"

                            android:gravity="center"

                            android:text="🔒&#10;SLOT 3&#10;LOCKED"

                            android:textColor="#FFFFFF"
                            android:textSize="12sp"

                            android:background="@drawable/slot_locked_bg" />

                    </LinearLayout>


                    <TextView
                        android:id="@+id/nextSlotText"

                        style="@style/GameTitle"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="13dp"

                        android:gravity="center"

                        android:text="Unlock Slot 2"
                        android:textColor="#57351F"
                        android:textSize="23sp" />


                    <TextView
                        android:id="@+id/slotUpgradeCostText"

                        style="@style/GameTitle"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:gravity="center"

                        android:text="Cost: 🥚 5K"
                        android:textColor="#57351F"
                        android:textSize="19sp" />


                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/upgradeSlotButton"

                        style="@style/GameButtonText"

                        android:layout_width="250dp"
                        android:layout_height="58dp"

                        android:layout_marginTop="17dp"

                        android:text="🔓 UNLOCK SLOT"

                        android:textColor="#FFFFFF"

                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeMaxTextSize="20sp"
                        android:autoSizeStepGranularity="1sp"

                        android:background="@drawable/game_buy_button_bg"

                        app:backgroundTint="@null" />

                </LinearLayout>

            </ScrollView>


        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>