<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/chickeninc_bg"
        android:scaleType="centerCrop"
        android:contentDescription="Farm background" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#18000000" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:paddingTop="70dp"
        android:paddingBottom="50dp">

        <TextView
            android:id="@+id/gameTitle"
            style="@style/GameTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="CHICKEN INC."
            android:textColor="#FFD34E"
            android:textSize="38sp"
            android:shadowColor="#6B3D21"
            android:shadowDx="2"
            android:shadowDy="3"
            android:shadowRadius="3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/gameSubtitle"
            style="@style/GameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Build the ultimate chicken farm!"
            android:textColor="#57351F"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/gameTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/homeChickenImage"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="18dp"
            android:src="@drawable/basic_chicken"
            android:scaleType="fitCenter"
            android:contentDescription="Chicken"
            app:layout_constraintTop_toBottomOf="@id/gameSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/homeButtonPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="18dp"
            android:background="@drawable/shop_popup_bg"
            android:elevation="9dp"
            app:layout_constraintTop_toBottomOf="@id/homeChickenImage"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/playButton"
                style="@style/GameButtonText"
                android:layout_width="260dp"
                android:layout_height="66dp"
                android:text="🐔 PLAY GAME"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:shadowColor="#5A3925"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:background="@drawable/game_buy_button_bg"
                android:elevation="8dp"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tutorialButton"
                style="@style/GameButtonText"
                android:layout_width="235dp"
                android:layout_height="57dp"
                android:layout_marginTop="16dp"
                android:text="📖 HOW TO PLAY"
                android:textColor="#57351F"
                android:textSize="18sp"
                android:background="@drawable/game_upgrade_button_bg"
                android:elevation="6dp"
                app:backgroundTint="@null" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/tutorialOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#99000000"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="65dp"
        android:paddingBottom="50dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:background="@drawable/shop_popup_bg"
            android:elevation="15dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <TextView
                    style="@style/GameTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="📖 HOW TO PLAY"
                    android:textColor="#57351F"
                    android:textSize="28sp" />

                <TextView
                    style="@style/GameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="🥚 PRODUCE EGGS"
                    android:textColor="#7A481F"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/GameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Your active chickens automatically produce eggs. Better chickens and upgrades produce more eggs."
                    android:textColor="#513824"
                    android:textSize="16sp"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    style="@style/GameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="😊 KEEP YOUR CHICKENS HAPPY"
                    android:textColor="#7A481F"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/GameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mood controls how quickly your chickens produce. Feed your flock to raise their mood. Chickens stop producing when mood gets too low."
                    android:textColor="#513824"
                    android:textSize="16sp"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    style="@style/GameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="🐔 BUILD YOUR FLOCK"
                    android:textColor="#7A481F"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/GameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Buy chickens from the Shop and deploy them to your farm. You can unlock up to three active chicken slots."
                    android:textColor="#513824"
                    android:textSize="16sp"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    style="@style/GameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="🔨 UPGRADE"
                    android:textColor="#7A481F"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/GameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Upgrade chickens to increase their production. You can also improve your feeder and unlock additional farm slots."
                    android:textColor="#513824"
                    android:textSize="16sp"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    style="@style/GameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="🎡 SPIN THE WHEEL"
                    android:textColor="#7A481F"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/GameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Use free spins and extra spin rolls to earn chickens and useful farm gadgets."
                    android:textColor="#513824"
                    android:textSize="16sp"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    style="@style/GameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="⭐ REBIRTH"
                    android:textColor="#7A481F"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/GameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Once you have enough eggs, you can rebirth. Rebirthing gives every chicken a permanent production multiplier."
                    android:textColor="#513824"
                    android:textSize="16sp"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    style="@style/GameTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="Grow your flock, earn more eggs, and build the strongest farm!"
                    android:textColor="#3F8A47"
                    android:textSize="17sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/closeTutorialButton"
                    style="@style/GameButtonText"
                    android:layout_width="210dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="22dp"
                    android:text="GOT IT!"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:background="@drawable/game_buy_button_bg"
                    android:elevation="7dp"
                    app:backgroundTint="@null" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

</FrameLayout>