<resources>

    <style name="GameText">
        <item name="android:fontFamily">@font/fredoka_semibold</item>
        <item name="android:textColor">#513824</item>
        <item name="android:includeFontPadding">false</item>
    </style>


    <style name="GameTitle">
        <item name="android:fontFamily">@font/fredoka_bold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#4B2E1C</item>
        <item name="android:includeFontPadding">false</item>
    </style>


    <style name="GameButtonText">
        <item name="android:fontFamily">@font/fredoka_bold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
    </style>


    <style name="GameResponsiveName" parent="GameTitle">

        <item name="android:gravity">center</item>

        <item name="android:maxLines">2</item>

        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeMaxTextSize">18sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>

        <item name="android:includeFontPadding">false</item>

    </style>
</resources>