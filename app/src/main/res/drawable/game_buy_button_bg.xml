<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape>

            <gradient
                android:startColor="#4EC75B"
                android:endColor="#32A94A"
                android:angle="90" />

            <corners android:radius="18dp" />

            <stroke
                android:width="3dp"
                android:color="#EEFFE8" />

        </shape>

    </item>


    <item>

        <shape>

            <gradient
                android:startColor="#87E761"
                android:endColor="#3FB85A"
                android:angle="90" />

            <corners android:radius="18dp" />

            <stroke
                android:width="3dp"
                android:color="#F2FFEB" />

        </shape>

    </item>

</selector>