<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape>

            <gradient
                android:startColor="#42BBD9"
                android:endColor="#26A89F"
                android:angle="90" />

            <corners android:radius="18dp" />

            <stroke
                android:width="3dp"
                android:color="#EFFFFF" />

        </shape>

    </item>


    <item>

        <shape>

            <gradient
                android:startColor="#70DEFA"
                android:endColor="#35C8BC"
                android:angle="90" />

            <corners android:radius="18dp" />

            <stroke
                android:width="3dp"
                android:color="#F1FFFF" />

        </shape>

    </item>

</selector>